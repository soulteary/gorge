# Copy to .env in this directory before running `docker compose up`.
# Compose reads .env from the directory holding docker-compose.yml.

# Image tag used for `image:` and pulled from ghcr.io when not building locally.
GORGE_IMAGE_TAG=latest

# Host port mapped to the render service. The in-container port stays 8140.
# Both the highlight and the diff endpoints are served here; the diff domain
# has no port of its own.
GORGE_RENDER_PORT=8140

# Shared secret for service-to-service calls. Sent as the X-Service-Token
# header (or ?token= query parameter). Leave empty to disable authentication —
# only acceptable on a private network. One token covers both domains: it
# authenticates the caller to the process, not to a route group.
GORGE_SERVICE_TOKEN=

# Maximum source size accepted by POST /api/highlight/render, in bytes.
# Larger payloads get 413 ERR_TOO_LARGE. Default 1 MiB.
GORGE_RENDER_MAX_BYTES=1048576

# Maximum combined size accepted by the diff endpoints, in bytes. The limit
# applies to len(old) + len(new), not to either side alone, so two 600 KiB
# files are over the default. Larger payloads get 413 ERR_TOO_LARGE.
#
# Keep this below the platform's 2M transport limit. Above it, an oversized
# request is refused by the body-limit middleware instead of by the domain
# check; both report ERR_TOO_LARGE, but only the domain check knows what it
# measured. Default 1 MiB.
GORGE_DIFF_MAX_BYTES=1048576

# Per-request timeout in seconds.
GORGE_RENDER_TIMEOUT_SEC=15

# Host port mapped to the notification service's client listener. The
# in-container port stays 22280. This is the WebSocket endpoint the browser
# talks to: Phorge builds a client URI from it and hands that URI to
# JX.Aphlict, so the address must resolve from the end user's machine. A value
# that only works between containers leaves every logged-in user unable to
# connect, even though the service itself is healthy.
GORGE_NOTIFICATION_CLIENT_PORT=22280

# Host port mapped to the notification service's admin listener, which is what
# Phorge's PHP side posts notifications to. The in-container port stays 22281,
# and it is a second port rather than a route on 22280 because Phorge requires
# distinct admin and client entries in notification.servers.
#
# Unlike render, this service has no equivalent of GORGE_SERVICE_TOKEN. The
# browser speaks Aphlict's wire protocol and cannot send a service token, so
# authentication would break compatibility and was left out on purpose. That
# makes network isolation the only thing standing between an attacker and the
# ability to push arbitrary notifications to any user. Publishing this port to
# the host is a local-development convenience; in a real deployment remove the
# mapping and let only the Phorge container reach it over the gorge network.
GORGE_NOTIFICATION_ADMIN_PORT=22281

# Optional path to an Aphlict-format JSON config file, read for its cluster
# peer list. Only needed when running more than one notification instance:
# without it, a message posted to one instance never reaches clients connected
# to another. Leave empty for a single instance.
#
# The path is resolved inside the container, so the file has to be mounted
# there first — a compose override adding a volume is the usual way.
GORGE_NOTIFICATION_CONFIG_FILE=

# Host port mapped to the mailer service. The in-container port stays 8110.
# Nothing outside the gorge network needs to reach it — Phorge's PHP side is
# the only caller — so dropping this mapping in a real deployment is safe and
# preferable.
GORGE_MAILER_PORT=8110

# The mailer backends, as a JSON list. This is the whole of the mailer's
# configuration; everything backend-specific lives in a spec's "options".
#
# The default is a single "test" backend, which accepts every message and
# delivers none of it. That is a deliberate choice for a first `up`: the
# service comes up ready, so the wiring can be verified end to end before any
# credentials exist. It is also why the value has to be replaced before the
# stack sends real mail — nothing will report an error, the mail simply goes
# nowhere.
#
# Entries are tried highest "priority" first, and the next one is tried only
# when the previous failed transiently. Supported types: smtp, sendmail, ses,
# sendgrid, mailgun, postmark, test.
#
#   GORGE_MAILER_CONFIG=[{"key":"smtp","type":"smtp","priority":100,"options":{"host":"mail.example.com","port":"587","protocol":"tls","user":"phorge","password":"secret"}}]
#
# Leaving this empty is a supported state, not an error: the service starts and
# reports itself *not ready*, which is what keeps orchestration from routing
# mail at a deployment that cannot deliver it.
GORGE_MAILER_CONFIG=[{"key":"test","type":"test"}]

# Retries within a *single* backend before failing over to the next one, and
# the wait between them, in seconds.
#
# These are small on purpose. Phorge's worker queue is the authoritative retry
# loop and it re-submits anything that is not reported as a permanent failure,
# so this loop only exists to absorb second-scale flakiness. The whole loop is
# bound by the request context, and the PHP client waits 30 seconds — raise
# these far enough and the client gives up while the service is still trying.
GORGE_MAILER_MAX_RETRIES=2
GORGE_MAILER_RETRY_WAIT=2

# Host port the search service is published on. The in-container port stays
# 8120 and is not configurable from here.
#
# It is spelled PUBLISH_PORT rather than PORT on purpose. This variable names
# the *host* side of a port mapping — which port on this machine forwards into
# the container. The phorge-fork orchestration has a variable named
# GORGE_SEARCH_PORT that means something different: the *internal* port its
# Phorge container dials gorge-search on. Both default to 8120, so nothing is
# broken today, but the two repositories are commonly driven from one .env and
# under one name the collision would only surface as "Phorge cannot reach
# search" after someone changed a host port.
#
# Nothing outside the gorge network needs to reach this service — Phorge's PHP
# side is the only caller — so dropping the mapping entirely in a real
# deployment is safe and preferable.
GORGE_SEARCH_PUBLISH_PORT=8120

# The search backends, as a JSON list. This is the whole of the search
# service's configuration.
#
# The default is a single "test" backend, which indexes into memory. Like the
# mailer's test default it exists so a first `up` comes out ready and the
# wiring can be verified before any cluster exists — but it is more dangerous
# than the mailer's, and in a way worth spelling out. A test mailer accepts
# mail and delivers none, which someone notices within a day. A test search
# backend accepts documents, answers queries about them correctly, and then
# loses the entire index on the next container restart. Phorge keeps working;
# search simply starts answering "no results" for a corpus it indexed
# yesterday, with a healthy container and a clean log.
#
# Replace it before pointing a real Phorge install at this service:
#
#   GORGE_SEARCH_BACKENDS=[{"type":"elasticsearch","hosts":["es:9200"],"index":"phabricator","version":7,"roles":["read","write"]}]
#   GORGE_SEARCH_BACKENDS=[{"type":"meilisearch","hosts":["meili:7700"],"index":"phabricator","apiKey":"...","roles":["read","write"]}]
#
# An entry's "roles" is what the fan-out reads: a document is written to every
# backend holding "write", while a query goes to the first holding "read" that
# answers, the rest being a failover chain. Two write backends is how a
# replacement index gets built beside a live one. Omitting "roles" entirely
# gives a backend both.
#
# "index" defaults to "phabricator", which is the name Phorge's own
# Elasticsearch engine has always used. Changing it is safe as long as nothing
# else points at the old one, but a deployment that changes it after indexing
# has an index it can no longer see rather than an error.
#
# Leaving this empty is a supported state, not an error: the service starts and
# reports itself *not ready*, which is what keeps a deployment from routing
# searches at something that cannot answer them. A value that fails to parse
# lands in the same place — no backends, not ready — with a warning in the log
# and nothing on the wire; see docs/findings.md #19.
GORGE_SEARCH_BACKENDS=[{"type":"test","roles":["read","write"]}]

# Host port mapped to the file storage service. The in-container port stays
# 8100. Like the mailer's, nothing outside the gorge network needs to reach it
# — Phorge's PHP side is the only caller — so dropping this mapping in a real
# deployment is safe and preferable. It is published here so tests/e2e/
# file-storage.sh can run against the stack.
GORGE_FILE_STORAGE_PORT=8100

# --- file storage backends ------------------------------------------------
#
# Each backend is switched on by its own settings and there is no list to
# declare. With none of them configured the service starts and reports itself
# *not ready*, which is a supported state rather than an error: it is what a
# deployment looks like while its storage is still being decided.
#
# Writes are tried in ascending priority: blob (1), local disk (5), S3 (100).
# A backend that refuses a file because of its size limit is skipped, and a
# backend that *fails* is followed by the next one — so a deployment with two
# backends survives one of them being briefly broken.

# The local disk backend's path, resolved *inside the container*, where the
# gorge_files volume is mounted. This is the one backend that needs nothing
# external, which is why the stack ships with it on: `docker compose up` gives
# a service that is ready and actually stores files.
#
# Changing this to a path the volume is not mounted at writes files into the
# container's own filesystem, where the next `docker compose up --build`
# silently discards them.
GORGE_FILE_LOCAL_DISK_PATH=/var/lib/gorge/files

# The MySQL blob backend, which stores small files as rows of Phorge's own
# `{namespace}_file.file_storageblob` table.
#
# The host is the switch: leave it empty and the backend is not registered at
# all. That matters more than it looks — the backend has priority 1, so a host
# pointing at a database that is not there would collect every small upload,
# fail it, and make /readyz report the whole service unavailable.
#
# There is no MySQL in this compose file, so it is off here. Two things to read
# before turning it on next to a real Phorge: it writes the *same table* with
# the *same handle scheme* as Phorge's own native MySQL engine
# (compat/phorge/README.md section 8), and the table itself is created by
# Phorge's `bin/storage upgrade`, so the backend cannot work before that has
# run — it fails writes, which the router then sends to local disk.
GORGE_FILE_MYSQL_HOST=
GORGE_FILE_MYSQL_PORT=3306
GORGE_FILE_MYSQL_USER=phorge
GORGE_FILE_MYSQL_PASS=
GORGE_FILE_NAMESPACE=phorge

# Largest file the blob backend will accept, in bytes. Anything larger is sent
# to the next backend by priority rather than refused.
#
# A row is read into memory whole, which is what keeps this default small. It
# is also the rewind budget for the write fall-through: the router remembers up
# to this many bytes so a failed blob write can be retried on local disk. Set
# it to 0 to disable the backend while keeping the connection settings.
GORGE_FILE_MYSQL_BLOB_MAX_SIZE=1000000

# The S3 backend. All five are required together — a partial configuration
# leaves the backend unregistered rather than building a client that fails
# every request.
#
# The endpoint is explicit and path-style addressing is used, so this works
# against MinIO and Ceph as well as AWS. Keys are minted as
# `phabricator[/instance]/ab/cd/{16 hex}`, which is Phorge's own layout: a
# bucket written by Phorge's native S3 engine is readable here and the other
# way round.
GORGE_FILE_S3_BUCKET=
GORGE_FILE_S3_ACCESS_KEY=
GORGE_FILE_S3_SECRET_KEY=
GORGE_FILE_S3_REGION=
GORGE_FILE_S3_ENDPOINT=

# Optional instance name, inserted as a path segment in S3 keys so several
# Phorge instances can share one bucket. Changing it after files exist leaves
# every earlier object in place and unreachable, with no error anywhere.
GORGE_FILE_INSTANCE_NAME=
