# Gorge 测试 demo 的环境变量。
#   cp .env.demo .env
# compose 会自动读同目录的 .env；也可以直接：
#   docker compose --env-file .env.demo -f docker-compose.demo.yml up -d --build

# gorge 镜像标签后缀（Compose 会补服务前缀；latest 会变成 search-latest 等）。
GORGE_IMAGE_TAG=latest

# 服务间共享密钥。demo 默认留空 = 不鉴权，所有 gorge 服务只绑回环，够本机用。
# 想验鉴权就设一个值，并在调 gorge-search/mailer/webhook 时带 X-Service-Token。
GORGE_SERVICE_TOKEN=

# --- 搜索后端 ---------------------------------------------------------------
# Meilisearch 主密钥，gorge-search 的 apiKey 会用同一个值，两处必须一致。
MEILI_MASTER_KEY=demo-master-key
MEILI_PUBLISH_PORT=7700
ES_PUBLISH_PORT=9200

# --- OwlMail（测试邮箱）----------------------------------------------------
OWLMAIL_WEB_PORT=1080
OWLMAIL_SMTP_PORT=1025

# --- webhook 接收端 --------------------------------------------------------
WEBHOOK_RECEIVER_PORT=9000
# 必须是 extend 变体：latest 是 scratch 镜像，没有 wget（健康探针要用）也没有
# /bin/sh（hooks.json 的 execute-command 要用）。理由见 compose 里那段注释。
WEBHOOK_RECEIVER_TAG=extend-7.3.0

# --- MySQL（只为 gorge-webhook 提供 herald 库）-----------------------------
MYSQL_ROOT_PASSWORD=demo-root
MYSQL_USER=phorge
MYSQL_PASSWORD=phorge
MYSQL_PUBLISH_PORT=3306
# 库名前缀，seed 建的是 {namespace}_herald。改这里要同时改 seed/herald.sql。
GORGE_WEBHOOK_NAMESPACE=phabricator

# --- gorge 服务对宿主发布的端口（都只绑回环）-------------------------------
GORGE_SEARCH_PUBLISH_PORT=8120
GORGE_MAILER_PORT=8110
GORGE_WEBHOOK_PORT=8160
